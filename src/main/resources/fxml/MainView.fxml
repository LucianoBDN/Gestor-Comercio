<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tunegocio.app.controller.MainController">
    <left>
        <VBox spacing="8" prefWidth="160">
            <padding>
                <Insets top="16" right="8" bottom="16" left="8"/>
            </padding>
            <Button fx:id="btnIngresos" text="Ingresos" prefWidth="160" onAction="#onIngresosClick"/>
            <Button fx:id="btnEgresos" text="Egresos" prefWidth="160" onAction="#onEgresosClick"/>
            <Button fx:id="btnProveedores" text="Proveedores" prefWidth="160" disable="true"/>
            <Button fx:id="btnPedidos" text="Pedidos" prefWidth="160" disable="true"/>
            <Button fx:id="btnDashboard" text="Dashboard" prefWidth="160" disable="true"/>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="contentArea"/>
    </center>
</BorderPane>
